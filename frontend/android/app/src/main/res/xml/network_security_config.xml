<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- السماح بـ cleartext traffic للخوادم المحلية -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">192.168.1.170</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    
    <!-- السماح بجميع اتصالات HTTPS مع Amazon APIs -->
    <domain-config>
        <domain includeSubdomains="true">execute-api.us-east-1.amazonaws.com</domain>
        <domain includeSubdomains="true">amazonaws.com</domain>
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </domain-config>
    
    <!-- إعدادات عامة - تحديث للتوافق مع جميع الشبكات -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </base-config>
    
    <!-- إضافة دعم أفضل لـ HTTPS -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system"/>
            <certificates src="user"/>
        </trust-anchors>
    </debug-overrides>
</network-security-config>
